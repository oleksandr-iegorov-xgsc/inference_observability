# Exact container image tags are intentionally pinned. Copy to .env and set a strong local Grafana password.
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.7.3
GRAFANA_IMAGE=docker.io/grafana/grafana:12.1.0
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.9.1
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.4.0-4.5.0-ubuntu22.04
PROMETHEUS_RETENTION=30d
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DCGM_EXPORTER_PORT=9400
NVIDIA_OCI_HOOKS_DIR=/opt/agent_infrastructure/podman_vllm/hooks
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_SECRET
