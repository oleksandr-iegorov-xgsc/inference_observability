# Exact container image tags are intentionally pinned. Copy to .env and set a strong local Grafana password.
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.7.3
GRAFANA_IMAGE=docker.io/grafana/grafana:12.1.0
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.9.1
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.4.0-4.5.0-ubuntu22.04
PROMETHEUS_RETENTION=30d
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DCGM_EXPORTER_PORT=9400
# Stable Prometheus host label for this stack. Use the same value with
# ./scripts/generate_targets.py --host when generating vLLM target files.
FLEET_HOST=AIMachine002
# Hermes home on this host. The exporter reads HERMES_HOME/profiles read-only.
HERMES_HOME=/home/aimachine2/.hermes
# UID/GID that owns HERMES_HOME; needed for 0700 Hermes profile directories.
HERMES_UID=1000
HERMES_GID=1000
HERMES_LCM_EXPORTER_IMAGE=hermes-lcm-prometheus-exporter:local
HONCHO_EXPORTER_IMAGE=honcho-prometheus-exporter:local
NVIDIA_OCI_HOOKS_DIR=/opt/agent_infrastructure/podman_vllm/hooks
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_SECRET
